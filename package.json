{
  "name": "ravn-core-repo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "skills": [
      "./plugins/agent/ravn-core/skills"
    ],
    "extensions": [
      "./plugins/agent/ravn-core/pi/promptify.ts"
    ]
  },
  "scripts": {
    "build:promptify-gui": "bun build plugins/agent/ravn-core/opencode/promptify-gui.ts --target=node --format=cjs --external @opencode/plugin/gui --external @opencode/plugin/rpc --external effect --outfile=plugins/agent/ravn-core/opencode/promptify-gui.cjs",
    "prepare": "node scripts/install-git-hooks.ts",
    "test": "node --test \"test/**/*.test.ts\" \"evals/private/test/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "biome format --write",
    "check": "biome format && oxlint && tsc && pnpm test && pnpm sync:versions:check",
    "validate:plugins": "node scripts/validate-plugins.ts",
    "sync:versions": "node scripts/sync-versions.ts",
    "sync:versions:check": "node scripts/sync-versions.ts --check",
    "prose:check": "node scripts/check-prose.ts",
    "eval:fetch": "node evals/fetch-private.ts",
    "eval": "node evals/run.ts --arms current",
    "eval:compare": "node evals/run.ts --repeat 3",
    "eval:smoke": "node evals/run.ts --smoke",
    "eval:skill-nudge": "node evals/skill-nudge/run.ts",
    "eval:report": "node evals/report.ts",
    "eval:view": "promptfoo view"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@oxlint/plugins": "1.93.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.19.2",
    "github-slugger": "2.0.0",
    "markdown-it": "14.3.3",
    "oxlint": "1.93.0",
    "promptfoo": "0.125.1",
    "typescript": "^7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@11.25.0"
}
